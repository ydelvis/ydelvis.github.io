---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
  </header>

  <article>
    {% for role in page.roles %}
      <h2 class="role-section-heading">{{ role.name }}</h2>
      <div class="role-list">
        {% for course in role.courses %}
          <div class="role-item">
            <span class="bento-badge role-badge">{{ course.term }}</span>
            <div class="role-body">
              {% if course.code %}
                <div>
                  {%- if course.url -%}
                    <a href="{{ course.url }}" class="role-title">{{ course.code }}</a>
                  {%- else -%}
                    <span class="role-title">{{ course.code }}</span>
                  {%- endif -%}
                  {%- if course.name %} &mdash; {{ course.name }}{% endif -%}
                  {%- if course.instructor %}, by
                    {%- if course.instructor_url %} <a href="{{ course.instructor_url }}">{{ course.instructor }}</a>
                    {%- else %} {{ course.instructor }}
                    {%- endif -%}
                  {%- endif -%}
                </div>
                {% if course.school %}
                  <div class="role-org">{{ course.school }}</div>
                {% endif %}
              {% elsif course.school %}
                <span class="role-title">{{ course.school }}</span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </article>
</div>
