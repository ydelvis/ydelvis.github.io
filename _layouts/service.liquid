---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    <div class="role-list">
      {% for entry in page.entries %}
        <div class="role-item">
          <span class="bento-badge role-badge">{{ entry.period }}</span>
          <div class="role-body">
            <div>
              {% if entry.url %}
                <a href="{{ entry.url }}" class="role-title">{{ entry.title }}</a>
              {% else %}
                <span class="role-title">{{ entry.title }}</span>
              {% endif %}
            </div>
            {% if entry.org %}
              <div class="role-org">{{ entry.org }}</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </article>
</div>
