<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    <div
      class="news-timeline"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw; overflow-y: auto"
      {% endif %}
    >
      {% for item in news limit: news_limit %}
        {% assign cat = 'update' %}
        {% assign body = item.content %}
        {% if body contains 'accepted' or body contains 'Accepted' %}
          {% assign cat = 'publication' %}
        {% endif %}
        {% if body contains 'Travel grant' or body contains 'Awarded' or body contains 'Selected for' or body contains 'Honored' or body contains 'Scholarship' or body contains 'Fellowship' %}
          {% assign cat = 'award' %}
        {% endif %}
        {% if body contains 'Presented' or body contains 'Guest Speaker' or body contains 'Volunteered as a Judge' %}
          {% assign cat = 'talk' %}
        {% endif %}
        {% if body contains 'Teaching Assistant' or body contains 'TA for' %}
          {% assign cat = 'teaching' %}
        {% endif %}
        <div class="news-timeline-item">
          <span class="bento-dot bento-dot--{{ cat }}"></span>
          <div class="news-timeline-body">
            <span class="news-timeline-date">{{ item.date | date: '%b %d, %Y' }}</span>
            <div class="news-timeline-text">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
